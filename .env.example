# Polymarket API credentials (required for live trading)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# Polygon wallet (required for live trading)
POLYGON_PRIVATE_KEY=

# Optional: override default capital
INITIAL_CAPITAL=215.0

# Optional: override RPC
POLYGON_RPC_URL=https://polygon-rpc.com

# Logging level (trace, debug, info, warn, error)
RUST_LOG=merge_bot=info
